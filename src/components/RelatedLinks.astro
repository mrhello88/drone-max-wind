---
type Item = { href: string; label: string };

type Props = {
	title?: string;
	links: Item[];
};

const { title = "Also on this site", links } = Astro.props;
---

<nav class="mt-10 border-t border-hairline pt-6" aria-label="Related pages">
	<p class="font-mono text-caption uppercase tracking-wide text-mute">{title}</p>
	<ul class="mt-3 grid gap-2 sm:grid-cols-2">
		{
			links.map((link) => (
				<li>
					<a class="text-sm font-medium text-link hover:underline" href={link.href}>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
