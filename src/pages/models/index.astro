---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { calculatorPath, groupedDrones } from "../../data/drones";

const groups = groupedDrones();
---

<Layout
	title="Drone wind resistance database | Drone Max Wind"
	description="Published wind ratings for DJI, Autel, Skydio, Holy Stone, Potensic, HoverAir, and Freefly. Open any model calculator."
>
	<Header />
	<main class="page-wrap py-16">
		<p class="font-mono text-caption uppercase tracking-wide text-mute">Database</p>
		<h1 class="mt-3 text-display-lg font-semibold text-ink">Every model we score.</h1>
		<p class="mt-4 max-w-2xl text-body-lg text-body">
			Select a name in the{" "}
			<a href="/#calculator" class="text-link">calculator</a>,{" "}
			<a href="/compare" class="text-link">compare two airframes</a>, or open a dedicated page
			for the exact phrase people type into Google. Ratings follow DJI{" "}
			<a href="/drone-wind-resistance-levels" class="text-link">wind resistance levels</a>.
		</p>
		{
			groups.map(([brand, list]) => (
				<section class="mt-12">
					<h2 class="text-display-sm font-semibold text-ink">{brand}</h2>
					<ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
						{list.map((drone) => (
							<li>
								<a
									href={calculatorPath(drone)}
									class="block rounded-md bg-canvas p-5 shadow-card"
								>
									<p class="text-base font-medium text-ink">{drone.name}</p>
									<p class="mt-1 text-sm text-body">
										{drone.windLevel} · {drone.maxWindMs} m/s · {drone.weightG} g
									</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
		<RelatedLinks
			links={[
				{ href: "/#calculator", label: "Open the calculator" },
				{ href: "/compare", label: "Compare two models" },
				{ href: "/drone-wind-resistance", label: "What wind resistance means" },
				{ href: "/drone-wind-resistance-levels", label: "Level 4 vs Level 5" },
			]}
		/>
	</main>
	<Footer />
</Layout>
