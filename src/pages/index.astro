---
import Calculator from "../components/Calculator.astro";
import FaqTabs from "../components/FaqTabs.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { calculatorPath, drones } from "../data/drones";
import { faqLd, organizationLd, webAppLd, websiteLd } from "../lib/schema";

const featured = drones.slice(0, 6);
const homeFaqs = [
	{
		tab: "Top resistance",
		q: "Which drone has top wind resistance?",
		a: "In our consumer and cinema database, DJI Inspire 3 is the highest published ceiling at 14 m/s (about 31 mph). DJI FPV is next at 13.8 m/s. A higher spec is not a guarantee in gusts at 120 m. Compare models, then run a field check.",
	},
	{
		tab: "Safe speed",
		q: "What wind speed is safe to fly a drone?",
		a: "There is no one max for every drone. Use that model’s published limit, then stay well under it, gusts included. On this site, caution starts near 65% of the limit and no go near 85% at 10 m, 80 m, or 120 m. Mini and Air class is often Level 5 (about 10.7 to 12 m/s). If trees and the app disagree, stay down.",
	},
	{
		tab: "Too much wind",
		q: "How much wind is too much for a drone?",
		a: "Too much is when sustained wind or gusts eat the buffer on your airframe. We call no go near 85% of the published limit, or any gust at the limit. If 80 m or 120 m is already in that band, keep it on the ground even if 10 m looks fine.",
	},
	{
		tab: "Level 5",
		q: "What is Level 5 wind resistance for a drone?",
		a: "On DJI’s scale, Level 5 is about 10.7 to 12 m/s sustained (roughly 24 to 27 mph). Mini 4 Pro, Air 3S, and many Mavic models sit in that class. It is a manufacturer bucket, not a promise that 12 m/s at 400 ft is easy.",
	},
];
---

<Layout
	title="Drone Max Wind | free go / no go wind calculator."
	description="Check if it is safe to fly your DJI, Autel, Skydio, or Holy Stone drone. Free wind at 10 m, 80 m, and 120 m with an instant go / no go verdict. No account."
	jsonLd={[organizationLd(), websiteLd(), webAppLd(), faqLd(homeFaqs)]}
>
	<Header />
	<main>
		<section class="relative isolate overflow-hidden">
			<div
				class="hero-mesh pointer-events-none absolute inset-x-0 top-0 h-[85vh] max-h-[42rem]"
				aria-hidden="true"
			>
			</div>
			<div class="page-wrap relative min-w-0 py-10 sm:py-16 lg:py-24">
				<div class="mx-auto min-w-0 max-w-2xl text-center sm:mx-0 sm:text-left">
					<p class="font-mono text-[11px] uppercase tracking-wide text-mute sm:text-caption">
						Flight safety · 10 m / 80 m / 120 m
					</p>
					<h1 class="mt-3 text-[26px] leading-8 font-semibold tracking-[-1px] text-balance text-ink sm:mt-4 sm:text-display-lg sm:leading-10 md:text-display-xl">
						Know the wind before the props spin.
					</h1>
					<p class="mt-4 text-[15px] leading-6 text-body sm:mt-5 sm:text-body-lg">
						Select the airframe:{" "}
						<a href="/dji-mini-4-pro-wind-resistance-calculator" class="text-link">Mini 4 Pro</a>,{" "}
						<a href="/dji-air-3s-wind-resistance-calculator" class="text-link">Air 3S</a>,{" "}
						<a href="/dji-neo-wind-resistance-calculator" class="text-link">Neo</a>, or the{" "}
						<a href="/models" class="text-link">full list</a>. We already store its published
						limit. You get a go / no go for this field, with gusts at the US 400 ft ceiling.
						See <a href="/how-it-works" class="text-link">how the call works</a>.
					</p>
					<dl class="mt-6 grid grid-cols-3 gap-3 border-y border-hairline py-4 sm:mt-8 sm:gap-4 sm:py-5">
						<div>
							<dt class="font-mono text-caption uppercase text-mute">Surface</dt>
							<dd class="mt-1 text-xs font-medium text-ink sm:text-sm">10 m</dd>
						</div>
						<div>
							<dt class="font-mono text-caption uppercase text-mute">Cruise</dt>
							<dd class="mt-1 text-xs font-medium text-ink sm:text-sm">80 m</dd>
						</div>
						<div>
							<dt class="font-mono text-caption uppercase text-mute">Legal max</dt>
							<dd class="mt-1 text-xs font-medium text-ink sm:text-sm">120 m</dd>
						</div>
					</dl>
					<div class="mt-8 flex flex-wrap justify-center gap-3 sm:justify-start">
						<a
							href="#calculator"
							class="inline-flex h-11 items-center rounded-pill bg-primary px-5 text-sm font-medium text-on-primary"
							>Open the check</a
						>
						<a
							href="/models"
							class="inline-flex h-11 items-center rounded-pill border border-hairline bg-canvas px-5 text-sm font-medium text-ink"
							>Browse models</a
						>
					</div>
				</div>
			</div>
		</section>

		<section class="page-wrap pb-16 lg:pb-24">
			<div class="mb-6 flex flex-col gap-2 text-center sm:flex-row sm:items-end sm:justify-between sm:text-left">
				<div>
					<p class="font-mono text-caption uppercase tracking-wide text-mute">Field check</p>
					<h2 class="mt-2 text-xl leading-7 font-semibold tracking-[-0.6px] text-balance text-ink sm:text-display-md">Run it here. Results stay in the panel.</h2>
				</div>
				<p class="max-w-sm text-sm text-body">
					Verdict, three altitudes, live conditions, and 12 hours, all inside the instrument.
					The page length does not change.
				</p>
			</div>
			<Calculator />
		</section>

		<section class="page-wrap grid gap-px overflow-hidden rounded-lg bg-hairline md:grid-cols-3">
			<article class="bg-canvas p-6 sm:p-8">
				<p class="font-mono text-caption uppercase text-mute">01</p>
				<h2 class="mt-4 text-display-sm font-semibold text-ink">The limit is already in.</h2>
				<p class="mt-2 text-sm leading-6 text-body">
					<a href="/dji-mini-4-pro-wind-resistance-calculator" class="text-link">Mini 4 Pro</a>,{" "}
					<a href="/dji-air-3s-wind-resistance-calculator" class="text-link">Air 3S</a>,{" "}
					<a href="/dji-neo-wind-resistance-calculator" class="text-link">Neo</a>, Flip, Autel,
					Holy Stone. Pick the name in the{" "}
					<a href="/models" class="text-link">database</a>. We fill the rating.
				</p>
			</article>
			<article class="bg-canvas p-6 sm:p-8">
				<p class="font-mono text-caption uppercase text-mute">02</p>
				<h2 class="mt-4 text-display-sm font-semibold text-ink">Three heights. No paywall.</h2>
				<p class="mt-2 text-sm leading-6 text-body">
					Takeoff, cruise, and the US recreational ceiling. Free.{" "}
					<a href="/drone-wind-resistance-levels" class="text-link">Level 4 vs Level 5</a>{" "}
					explained.
				</p>
			</article>
			<article class="bg-canvas p-6 sm:p-8">
				<p class="font-mono text-caption uppercase text-mute">03</p>
				<h2 class="mt-4 text-display-sm font-semibold text-ink">A verdict, not a lecture.</h2>
				<p class="mt-2 text-sm leading-6 text-body">
					Safe. Caution. Do not fly. One sentence why, with a 15% gust buffer.{" "}
					<a href="/how-it-works" class="text-link">Read the method</a>.
				</p>
			</article>
		</section>

		<section class="mt-16 bg-band text-on-band sm:mt-24">
			<div class="page-wrap grid gap-10 py-20 lg:grid-cols-2 lg:items-center lg:py-24">
				<div>
					<p class="font-mono text-caption uppercase tracking-wide text-on-band/50">
						Built for the field
					</p>
					<h2 class="mt-4 text-display-lg font-semibold">One column. One thumb.</h2>
					<p class="mt-4 max-w-md text-base leading-6 text-on-band/70">
						The instrument is dark because most checks happen outdoors. Controls stay 44 px.
						Last drone and place stay on this phone.
					</p>
				</div>
				<div class="rounded-md border border-white/10 bg-white/5 p-6 font-mono text-sm leading-7 text-on-band/80">
					<p>10 m · takeoff</p>
					<p>80 m · cruise</p>
					<p>120 m · 400 ft AGL</p>
					<p class="mt-4 text-go">If gusts eat the buffer, we say no.</p>
				</div>
			</div>
		</section>

		<section class="page-wrap py-16">
			<p class="text-sm leading-6 text-body">
				Read <a class="text-link" href="/drone-wind-resistance">wind resistance</a>,{" "}
				<a class="text-link" href="/drone-wind-resistance-levels">levels</a>,{" "}
				<a class="text-link" href="/drone-weather">drone weather</a>, and{" "}
				<a class="text-link" href="/how-it-works">how the verdict is made</a> before you treat
				a green badge as permission.
			</p>
			<FaqTabs items={homeFaqs} title="Wind questions before you fly" />
		</section>

		<section class="page-wrap py-20 sm:py-24">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="font-mono text-caption uppercase text-mute">Model pages</p>
					<h2 class="mt-2 text-display-lg font-semibold text-ink">A check per airframe.</h2>
				</div>
				<a href="/models" class="text-sm font-medium text-link">All models →</a>
			</div>
			<ul class="mt-10 grid gap-px overflow-hidden rounded-lg bg-hairline sm:grid-cols-2 lg:grid-cols-3">
				{
					featured.map((drone) => (
						<li>
							<a href={calculatorPath(drone)} class="block bg-canvas p-5 transition hover:bg-canvas-soft">
								<p class="font-mono text-caption uppercase text-mute">{drone.brand}</p>
								<p class="mt-2 text-display-sm font-semibold text-ink">{drone.name}</p>
								<p class="mt-1 font-mono text-caption text-body">
									{drone.windLevel} · {drone.maxWindMs} m/s
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
	<Footer />
</Layout>
