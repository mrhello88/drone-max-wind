---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Something broke | Drone Max Wind"
	description="Drone Max Wind hit a server error. Try the calculator again in a moment."
>
	<Header />
	<main class="page-wrap max-w-3xl py-24">
		<p class="font-mono text-caption uppercase tracking-wide text-mute">500</p>
		<h1 class="mt-3 text-display-lg font-semibold text-ink">The page failed to load.</h1>
		<p class="mt-5 text-body-lg text-body">
			That is on us, not on your drone. Wait a moment, then open the check again. No internal
			error details are shown here on purpose.
		</p>
		<p class="mt-8">
			<a class="font-medium text-link" href="/">Go home →</a>
		</p>
	</main>
	<Footer />
</Layout>
