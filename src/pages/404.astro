---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Page not found — Drone Max Wind"
	description="That URL is not on Drone Max Wind. Open the calculator, models, or guides."
>
	<Header />
	<main class="page-wrap max-w-3xl py-24">
		<p class="font-mono text-caption uppercase tracking-wide text-mute">404</p>
		<h1 class="mt-3 text-display-lg font-semibold text-ink">This page is not on the map.</h1>
		<p class="mt-5 text-body-lg text-body">
			The link may be old, or the path was typed wrong. The check itself is still on the home
			page.
		</p>
		<ul class="mt-8 space-y-2 text-sm">
			<li><a class="font-medium text-link" href="/#calculator">Calculator</a></li>
			<li><a class="font-medium text-link" href="/models">Model database</a></li>
			<li><a class="font-medium text-link" href="/drone-wind-resistance">Wind resistance guide</a></li>
			<li><a class="font-medium text-link" href="/drone-weather">Drone weather</a></li>
		</ul>
	</main>
	<Footer />
</Layout>
